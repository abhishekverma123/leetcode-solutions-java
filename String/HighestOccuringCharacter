  /*
  1. create a frequency array of size 256, 
  because 256 is the highest ascii value of character

  2. Traverse the whole string and update most occurence chacter ascii value in the array 
  3. find max , update max, if max is smaller 
  4. save character in the variable and return character
  */

     int freq[] = new int[256];

	 for(int i = 0; i < str.length(); i++){
		    freq[str.charAt(i)] = freq[str.charAt(i)]+1;
	 }

    int max = -1;
	char ch = ' ';
	for(int i =0; i < str.length(); i++){
		  if(max <  freq[str.charAt(i)]){
			  max =  freq[str.charAt(i)];
			  ch =  str.charAt(i);
		  }
	}

             return ch;
	}

}


